VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Server-side only — SIN prefijo VITE_ para que Vite nunca la incluya en el bundle del navegador.
# Solo la leen las funciones serverless en /api (process.env.ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=sk-ant-...

# Contraseña de la cuenta demo (solo servidor, SIN prefijo VITE_). La lee únicamente api/demo-login.ts.
# Si no está definida, la demo no está disponible y el botón "Probar demo" no aparece.
DEMO_PASSWORD=
